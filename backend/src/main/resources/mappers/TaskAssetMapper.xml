<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pixelflow.task.mapper.TaskAssetMapper">

  <insert id="insertBatch">
    INSERT INTO task_asset (task_id, slot_index, asset_id)
    VALUES
    <foreach collection="assetIds" item="assetId" index="slotIndex" separator=",">
      (#{taskId}, #{slotIndex}, #{assetId})
    </foreach>
  </insert>

</mapper>
