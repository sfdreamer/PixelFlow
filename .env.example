# PixelFlow 演示环境变量。只含非敏感演示值，复制为 .env 后即可 docker compose up。
# 生产/共享环境必须替换数据库口令、关闭模拟控制，并按需启用 COOKIE_SECURE。

# ---- 数据库（mysql 服务与 api 服务共用）----
DB_HOST=mysql
DB_PORT=3306
DB_NAME=pixelflow
DB_USER=pixelflow
DB_PASSWORD=pixelflow-demo-only
MYSQL_ROOT_PASSWORD=pixelflow-root-demo-only

# ---- 后端 Java ----
SERVER_PORT=8080
# 容器内上传与结果文件的根目录，必须指向挂载的持久卷
STORAGE_ROOT=/data/storage
# 允许发起非安全方法的浏览器来源，逗号分隔；容器演示即 http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# HTTPS 部署时设为 true，本地 HTTP 演示必须为 false，否则 Cookie 不会被发送
COOKIE_SECURE=false
# 演示环境开启 failAt/耗时控制；正式部署设为 false（携带 simulation 会返回 403 SIMULATION_DISABLED）
DEMO_CONTROLS_ENABLED=true
# 三阶段默认耗时（毫秒，0—30000），可被单个任务的 simulation 覆盖
STAGE_DELAY_ASSET_CHECK_MS=2000
STAGE_DELAY_GENERATE_MS=2000
STAGE_DELAY_FINALIZE_MS=2000
# 调度器空闲时的重试间隔
WORKER_FIXED_DELAY_MS=500

# ---- 前端 Next.js ----
# 浏览器只访问 http://localhost:3000；/api/v1/** 由 Next.js 转发到该地址（仅容器内部）
JAVA_API_ORIGIN=http://api:8080
WEB_PORT=3000
